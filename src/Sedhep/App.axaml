<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Sedhep"
             x:Class="Sedhep.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system theme; the Settings page can pin Light or Dark. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Sedhep/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://Sedhep/Styles/TwoToneIcons.axaml" />
                <ResourceInclude Source="avares://Sedhep/Styles/LightTheme.axaml" />
                <ResourceInclude Source="avares://Sedhep/Styles/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Sedhep/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
