<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Sedhep's palette is warm and paper-like: an heirloom recipe notebook rather than a social feed.
    Every colour comes from five brand hues, so the cookbook stays readable in a dim kitchen.

      Sandy Brown      #F3A361   the accent: the pot, the primary action, "here"
      Light Sea Green  #299C8E   kept and working: favourites, success
      Tomato           #E77051   destructive and wrong
      Dark Slate Gray  #265349   the ink on top of the accent, and the whole night theme
      Burly Wood       #E8C369   warmth: progress and the step timer

    The brand hues are mid-tones, so they carry text only through their darker "Ink" shades
    (and the lighter ones in the dark theme). Fills use the exact swatch.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Page" Color="#FBF6ED" />
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#F4EADB" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#EDDFCB" />
      <SolidColorBrush x:Key="Border" Color="#E7D8C3" />
      <SolidColorBrush x:Key="BorderStrong" Color="#D6C3A7" />

      <!-- Sandy Brown: the swatch for fills, a burnt shade for anything that has to be read. -->
      <SolidColorBrush x:Key="Accent" Color="#F3A361" />
      <SolidColorBrush x:Key="AccentHover" Color="#DE8A44" />
      <SolidColorBrush x:Key="AccentInk" Color="#B4611F" />
      <SolidColorBrush x:Key="AccentSoft" Color="#FBE7D2" />
      <!-- Dark Slate Gray, a shade deeper so a sandy button label still clears 5:1. -->
      <SolidColorBrush x:Key="OnAccent" Color="#1F433C" />

      <!-- The quiet greys still clear 4.5:1 on paper; the labels that use them are only 11.5px. -->
      <SolidColorBrush x:Key="TextPrimary" Color="#241C15" />
      <SolidColorBrush x:Key="TextSecondary" Color="#6F6152" />
      <SolidColorBrush x:Key="TextTertiary" Color="#7A6A57" />

      <!-- Light Sea Green -->
      <SolidColorBrush x:Key="Favorite" Color="#299C8E" />
      <SolidColorBrush x:Key="FavoriteInk" Color="#1B7C70" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#DFF1ED" />
      <SolidColorBrush x:Key="Success" Color="#299C8E" />
      <SolidColorBrush x:Key="SuccessInk" Color="#1B7C70" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#DFF1ED" />

      <!-- Tomato -->
      <SolidColorBrush x:Key="Danger" Color="#E77051" />
      <SolidColorBrush x:Key="DangerInk" Color="#B8432A" />
      <SolidColorBrush x:Key="DangerSoft" Color="#FBE3DC" />

      <!-- Burly Wood -->
      <SolidColorBrush x:Key="Highlight" Color="#E8C369" />
      <SolidColorBrush x:Key="HighlightInk" Color="#8A6414" />
      <SolidColorBrush x:Key="HighlightSoft" Color="#FBF0D3" />

      <SolidColorBrush x:Key="CardShadow" Color="#1F265349" />
      <SolidColorBrush x:Key="Scrim" Color="#99265349" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- The night theme is Dark Slate Gray, taken down to candlelight. -->
      <SolidColorBrush x:Key="Page" Color="#0E1B18" />
      <SolidColorBrush x:Key="Surface" Color="#16241F" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#1C2E28" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#233A33" />
      <SolidColorBrush x:Key="Border" Color="#2A423B" />
      <SolidColorBrush x:Key="BorderStrong" Color="#37534B" />

      <SolidColorBrush x:Key="Accent" Color="#F3A361" />
      <SolidColorBrush x:Key="AccentHover" Color="#F9BC90" />
      <SolidColorBrush x:Key="AccentInk" Color="#F7B383" />
      <SolidColorBrush x:Key="AccentSoft" Color="#3B2A1A" />
      <SolidColorBrush x:Key="OnAccent" Color="#14332C" />

      <SolidColorBrush x:Key="TextPrimary" Color="#F3EBE0" />
      <SolidColorBrush x:Key="TextSecondary" Color="#AAB7B0" />
      <SolidColorBrush x:Key="TextTertiary" Color="#83968E" />

      <SolidColorBrush x:Key="Favorite" Color="#4CBCAC" />
      <SolidColorBrush x:Key="FavoriteInk" Color="#5EC9BA" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#12332D" />
      <SolidColorBrush x:Key="Success" Color="#4CBCAC" />
      <SolidColorBrush x:Key="SuccessInk" Color="#5EC9BA" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#12332D" />

      <SolidColorBrush x:Key="Danger" Color="#E77051" />
      <SolidColorBrush x:Key="DangerInk" Color="#F4947C" />
      <SolidColorBrush x:Key="DangerSoft" Color="#3B221C" />

      <SolidColorBrush x:Key="Highlight" Color="#E8C369" />
      <SolidColorBrush x:Key="HighlightInk" Color="#F0D593" />
      <SolidColorBrush x:Key="HighlightSoft" Color="#3A301A" />

      <SolidColorBrush x:Key="CardShadow" Color="#80101815" />
      <SolidColorBrush x:Key="Scrim" Color="#B30B1512" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type scale. These are plain doubles so the Settings page can grow the whole app at once. -->
  <x:Double x:Key="FontDisplay">32</x:Double>
  <x:Double x:Key="FontCook">29</x:Double>
  <x:Double x:Key="FontTitle">24</x:Double>
  <x:Double x:Key="FontH2">20</x:Double>
  <x:Double x:Key="FontH3">16.5</x:Double>
  <x:Double x:Key="FontBody">15</x:Double>
  <x:Double x:Key="FontMeta">13</x:Double>
  <x:Double x:Key="FontLabel">11.5</x:Double>
  <x:Double x:Key="FontTab">11</x:Double>

  <!-- Radii -->
  <CornerRadius x:Key="RadiusCard">18</CornerRadius>
  <CornerRadius x:Key="RadiusControl">13</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusCover">16</CornerRadius>
</ResourceDictionary>
