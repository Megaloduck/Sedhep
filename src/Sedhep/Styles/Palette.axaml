<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Sedhep's palette is warm and paper-like: an heirloom recipe notebook rather than a social feed.
    Every colour is defined for both themes so the cookbook stays readable in a dim kitchen.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Page" Color="#FAF5EE" />
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#F4EBE0" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#EDE1D2" />
      <SolidColorBrush x:Key="Border" Color="#E8DBC9" />
      <SolidColorBrush x:Key="BorderStrong" Color="#D9C6AE" />

      <SolidColorBrush x:Key="Accent" Color="#BF531C" />
      <SolidColorBrush x:Key="AccentHover" Color="#A5460F" />
      <SolidColorBrush x:Key="AccentSoft" Color="#F8E5D7" />
      <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="TextPrimary" Color="#241C15" />
      <SolidColorBrush x:Key="TextSecondary" Color="#6F6152" />
      <SolidColorBrush x:Key="TextTertiary" Color="#9A8B79" />

      <SolidColorBrush x:Key="Favorite" Color="#B7790A" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#FBEFD2" />
      <SolidColorBrush x:Key="Danger" Color="#B12B20" />
      <SolidColorBrush x:Key="DangerSoft" Color="#FBE5E2" />
      <SolidColorBrush x:Key="Success" Color="#2C7A57" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#E1F2E9" />

      <SolidColorBrush x:Key="CardShadow" Color="#1F2C1A0F" />
      <SolidColorBrush x:Key="Scrim" Color="#99000000" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Page" Color="#12100E" />
      <SolidColorBrush x:Key="Surface" Color="#1C1915" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#252019" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#2D261E" />
      <SolidColorBrush x:Key="Border" Color="#342A20" />
      <SolidColorBrush x:Key="BorderStrong" Color="#463829" />

      <SolidColorBrush x:Key="Accent" Color="#E8863F" />
      <SolidColorBrush x:Key="AccentHover" Color="#F79B55" />
      <SolidColorBrush x:Key="AccentSoft" Color="#382315" />
      <SolidColorBrush x:Key="OnAccent" Color="#1B1208" />

      <SolidColorBrush x:Key="TextPrimary" Color="#F6EEE4" />
      <SolidColorBrush x:Key="TextSecondary" Color="#B4A492" />
      <SolidColorBrush x:Key="TextTertiary" Color="#8B7C6B" />

      <SolidColorBrush x:Key="Favorite" Color="#F0BC55" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#382C13" />
      <SolidColorBrush x:Key="Danger" Color="#F08B80" />
      <SolidColorBrush x:Key="DangerSoft" Color="#3A1E1B" />
      <SolidColorBrush x:Key="Success" Color="#6FC79E" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#163126" />

      <SolidColorBrush x:Key="CardShadow" Color="#66000000" />
      <SolidColorBrush x:Key="Scrim" Color="#B3000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type scale. These are plain doubles so the Settings page can grow the whole app at once. -->
  <x:Double x:Key="FontDisplay">32</x:Double>
  <x:Double x:Key="FontCook">29</x:Double>
  <x:Double x:Key="FontTitle">24</x:Double>
  <x:Double x:Key="FontH2">20</x:Double>
  <x:Double x:Key="FontH3">16.5</x:Double>
  <x:Double x:Key="FontBody">15</x:Double>
  <x:Double x:Key="FontMeta">13</x:Double>
  <x:Double x:Key="FontLabel">11.5</x:Double>
  <x:Double x:Key="FontTab">11</x:Double>

  <!-- Radii -->
  <CornerRadius x:Key="RadiusCard">18</CornerRadius>
  <CornerRadius x:Key="RadiusControl">13</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusCover">16</CornerRadius>
</ResourceDictionary>
