<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The house palette: a Mediterranean kitchen at golden hour.

      Blue-green       #264653   deep ink, the night palette, headings
      Teal             #2A9D8F   primary accent, selection and controls
      Golden yellow    #E9C46A   favorites, timers, warmth
      Warm orange      #F4A261   secondary warmth
      Coral            #E76F51   destructive actions

    Surfaces are sand and cream rather than white, so the cookbook reads like paper on a wooden
    table. Large radii and generous type carry the friendly, illustrated-book feeling; full-strength
    hues are reserved for fills, and interactive text uses contrast-safe ink shades.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Page" Color="#F6EEE1" />
      <SolidColorBrush x:Key="Surface" Color="#FFFCF6" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#F2E7D7" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#E8D9C4" />
      <SolidColorBrush x:Key="SurfaceWarm" Color="#F7E7D2" />
      <SolidColorBrush x:Key="Border" Color="#E9DAC6" />
      <SolidColorBrush x:Key="BorderStrong" Color="#D2B99E" />

      <!-- The darkest ink doubles as the brand colour, like the headline on a book cover. -->
      <SolidColorBrush x:Key="Ink" Color="#264653" />
      <SolidColorBrush x:Key="InkSoft" Color="#4C6266" />

      <SolidColorBrush x:Key="Accent" Color="#2A9D8F" />
      <SolidColorBrush x:Key="AccentHover" Color="#238A7E" />
      <SolidColorBrush x:Key="AccentInk" Color="#17665D" />
      <SolidColorBrush x:Key="AccentSoft" Color="#DCEFEA" />
      <SolidColorBrush x:Key="OnAccent" Color="#062C29" />

      <!-- Newsprint-adjacent greys that still clear 4.5:1 on cream. -->
      <SolidColorBrush x:Key="TextPrimary" Color="#22333A" />
      <SolidColorBrush x:Key="TextSecondary" Color="#59686B" />
      <SolidColorBrush x:Key="TextTertiary" Color="#66757A" />

      <!-- Golden: a starred recipe is a treat, not a warning. -->
      <SolidColorBrush x:Key="Favorite" Color="#E9C46A" />
      <SolidColorBrush x:Key="FavoriteInk" Color="#755515" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#F8EFCF" />
      <SolidColorBrush x:Key="Success" Color="#2A9D8F" />
      <SolidColorBrush x:Key="SuccessInk" Color="#17665D" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#DCEFEA" />

      <SolidColorBrush x:Key="Danger" Color="#E76F51" />
      <SolidColorBrush x:Key="DangerInk" Color="#B94C38" />
      <SolidColorBrush x:Key="DangerSoft" Color="#FBE5DE" />

      <SolidColorBrush x:Key="Highlight" Color="#E9C46A" />
      <SolidColorBrush x:Key="HighlightInk" Color="#755515" />
      <SolidColorBrush x:Key="HighlightSoft" Color="#F8EFCF" />

      <SolidColorBrush x:Key="CardShadow" Color="#1F264653" />
      <SolidColorBrush x:Key="Scrim" Color="#992E2A24" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <!-- Night is Dark Slate Gray taken down to candlelight, not a cold grey. -->
      <SolidColorBrush x:Key="Page" Color="#14262B" />
      <SolidColorBrush x:Key="Surface" Color="#1C3238" />
      <SolidColorBrush x:Key="SurfaceMuted" Color="#254046" />
      <SolidColorBrush x:Key="SurfaceSunken" Color="#2E4C52" />
      <SolidColorBrush x:Key="SurfaceWarm" Color="#3A3630" />
      <SolidColorBrush x:Key="Border" Color="#354F55" />
      <SolidColorBrush x:Key="BorderStrong" Color="#4A686E" />

      <SolidColorBrush x:Key="Ink" Color="#F3EBE0" />
      <SolidColorBrush x:Key="InkSoft" Color="#C6D2CC" />

      <SolidColorBrush x:Key="Accent" Color="#2FA695" />
      <SolidColorBrush x:Key="AccentHover" Color="#46BCA9" />
      <SolidColorBrush x:Key="AccentInk" Color="#86E0CF" />
      <SolidColorBrush x:Key="AccentSoft" Color="#1B3E3C" />
      <SolidColorBrush x:Key="OnAccent" Color="#06201E" />

      <SolidColorBrush x:Key="TextPrimary" Color="#F3EBE0" />
      <SolidColorBrush x:Key="TextSecondary" Color="#ABBAB4" />
      <SolidColorBrush x:Key="TextTertiary" Color="#93A39D" />

      <SolidColorBrush x:Key="Favorite" Color="#E9C46A" />
      <SolidColorBrush x:Key="FavoriteInk" Color="#F1D98E" />
      <SolidColorBrush x:Key="FavoriteSoft" Color="#40391F" />
      <SolidColorBrush x:Key="Success" Color="#48BBA8" />
      <SolidColorBrush x:Key="SuccessInk" Color="#76D8C7" />
      <SolidColorBrush x:Key="SuccessSoft" Color="#183D3D" />

      <SolidColorBrush x:Key="Danger" Color="#E76F51" />
      <SolidColorBrush x:Key="DangerInk" Color="#F39A82" />
      <SolidColorBrush x:Key="DangerSoft" Color="#442A27" />

      <SolidColorBrush x:Key="Highlight" Color="#E9C46A" />
      <SolidColorBrush x:Key="HighlightInk" Color="#F1D98E" />
      <SolidColorBrush x:Key="HighlightSoft" Color="#40391F" />

      <SolidColorBrush x:Key="CardShadow" Color="#80101815" />
      <SolidColorBrush x:Key="Scrim" Color="#B30D2026" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type scale. These are plain doubles so the Settings page can grow the whole app at once. -->
  <x:Double x:Key="FontBrand">40</x:Double>
  <x:Double x:Key="FontDisplay">33</x:Double>
  <x:Double x:Key="FontCook">30</x:Double>
  <x:Double x:Key="FontTitle">25</x:Double>
  <x:Double x:Key="FontH2">20</x:Double>
  <x:Double x:Key="FontH3">16.5</x:Double>
  <x:Double x:Key="FontBody">15</x:Double>
  <x:Double x:Key="FontMeta">13</x:Double>
  <x:Double x:Key="FontLabel">11.5</x:Double>
  <x:Double x:Key="FontTab">11</x:Double>

  <!-- Radii: soft printed-card corners. -->
  <CornerRadius x:Key="RadiusCard">22</CornerRadius>
  <CornerRadius x:Key="RadiusControl">15</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusCover">20</CornerRadius>
</ResourceDictionary>
