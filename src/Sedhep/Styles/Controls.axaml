<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sedhep.Controls">
  <!-- ============================ Typography ============================ -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Small caps metadata: the mono face, spaced out so it reads as a label, not a sentence. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontFamily" Value="{DynamicResource FontDataFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontLabel}" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>

  <!-- The brand line on the cookbook home, drawn as large as a book title. -->
  <Style Selector="TextBlock.brand">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBrand}" />
    <Setter Property="LineHeight" Value="46" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontDisplay}" />
    <Setter Property="LineHeight" Value="37" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontTitle}" />
    <Setter Property="LineHeight" Value="30" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontH2}" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Card titles stay in the text face: they are read, not displayed. -->
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource FontH3}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{DynamicResource FontDataFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontLabel}" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>

  <!-- Measures, times and counts are set like a recipe card: monospaced. -->
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFamily" Value="{DynamicResource FontDataFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.data">
    <Setter Property="FontFamily" Value="{DynamicResource FontDataFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- The one place the display face is used for small type: the rail, where there is room. -->
  <Style Selector="TextBlock.navLabel">
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontNav}" />
    <Setter Property="LineHeight" Value="20" />
  </Style>

  <!-- Bottom bar labels: the text face, because they are small and must stay legible. -->
  <Style Selector="TextBlock.tabLabel">
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontTab}" />
    <!-- No fixed line height: the label has to grow with the text-size setting too. -->
  </Style>

  <!-- ============================ Buttons ============================ -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontFamily" Value="{DynamicResource FontDisplayFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontH3}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- A disabled button should look disabled even with our own primary/outline brushes. -->
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Primary: one per screen, the thing the user came to do. -->
  <Style Selector="Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- Secondary: quiet, sits next to the primary action. -->
  <Style Selector="Button.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Outline: bordered, for actions beside content. -->
  <Style Selector="Button.outline">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.outline /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Danger -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerInk}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
  </Style>

  <!-- Bare: no chrome at all, used for rows and icon buttons. -->
  <Style Selector="Button.bare">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.bare /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A round icon target, for the one action that floats over a page. -->
  <Style Selector="Button.round">
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.round /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Button.round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- Icon button: 40x40 round target. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="Button.icon.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.icon.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
  </Style>

  <!-- Chip: filters and tags. -->
  <!-- A chip is a small reading label, not a heading: the text face, with room above and below. -->
  <Style Selector="Button.chip">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.chip.active">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.chip.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <!-- Bottom navigation: five equal places, with the raised create button in the middle. -->
  <Style Selector="Button.tab">
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="2,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
  </Style>
  <Style Selector="Button.tab TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>
  <Style Selector="Button.tab.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>

  <!--
    The raised create button that breaks the top line of the bottom bar, the way a thumb finds
    it without looking. The ring is the page colour, so it lifts off the bar.
  -->
  <Style Selector="Button.create">
    <Setter Property="Foreground" Value="{DynamicResource Page}" />
    <Setter Property="Width" Value="60" />
    <Setter Property="Height" Value="60" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Page}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.create /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Page}" />
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Button.create:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentInk}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Page}" />
  </Style>

  <!-- Rail: the desk version of the same five places, laid out like a book's table of contents. -->
  <Style Selector="Button.rail">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.rail /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
  </Style>
  <Style Selector="Button.rail TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="Button.rail.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
  </Style>
  <Style Selector="Button.rail.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>
  <!-- Set last so it wins over the resting colour above: the icon reads the button's ink. -->
  <Style Selector="Button.rail.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>

  <!-- The rail's one filled action: write a new recipe. -->
  <Style Selector="Button.newRecipe">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.newRecipe /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Page}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Page}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.newRecipe:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="Button.newRecipe TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>

  <!-- Text-only action, e.g. "Save" in the editor header. -->
  <Style Selector="Button.link">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- Sort switch: three plain words, the active one in the accent colour. -->
  <Style Selector="Button.sort">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontMeta}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sort /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sort.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.sort:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.sort.active:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentInk}" />
  </Style>

  <!-- ============================ Containers ============================ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="Border.flat">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="Border.pill.favorite">
    <Setter Property="Background" Value="{DynamicResource FavoriteSoft}" />
  </Style>

  <Style Selector="Border.pill.solid">
    <Setter Property="Background" Value="{DynamicResource Ink}" />
  </Style>

  <Style Selector="Border.cover">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
  </Style>

  <!-- A warm block inside a card: the ingredients list, a stat strip, a cookie-tin note. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceWarm}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- A recipe or ingredient card that lifts off the sand page. -->
  <Style Selector="Border.printed">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
  </Style>

  <!-- ============================ Inputs ============================ -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentInk}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- A plain checkbox, used for the "copy my cookbook" choice on desktop. -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontBodyFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBody}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Burly Wood: how far along something is. -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource HighlightInk}" />
    <Setter Property="Background" Value="{DynamicResource HighlightSoft}" />
  </Style>

  <Style Selector="Grid.page">
    <Setter Property="Background" Value="{DynamicResource Page}" />
  </Style>

  <Style Selector="Border.page">
    <Setter Property="Background" Value="{DynamicResource Page}" />
  </Style>

  <!-- A two-tone Material icon, drawn with the surrounding ink. -->
  <Style Selector="controls|TwoToneIcon">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|TwoToneIcon.favorite">
    <Setter Property="Foreground" Value="{DynamicResource FavoriteInk}" />
  </Style>
  <Style Selector="controls|TwoToneIcon.lg">
    <Setter Property="Width" Value="30" />
