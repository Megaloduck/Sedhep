<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.CategoryManagerView"
             x:DataType="vm:CategoryManagerViewModel"
             xmlns:controls="clr-namespace:Sedhep.Controls">
  <Grid Background="{DynamicResource Page}" RowDefinitions="Auto,*,Auto">
    <Border Padding="12,12,12,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="Back">
          <controls:TwoToneIcon Data="{StaticResource ToneChevronLeft}" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" />
        </Button>
        <TextBlock Grid.Column="1" Classes="h2" Text="Categories" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Grid.Column="2" Width="42" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="18,6,18,18" Spacing="14">
        <TextBlock Classes="muted"
                   Text="Rename a category, add your own, or remove one. Removing a category never removes the recipes in it — they simply move to “No category”." />

        <ItemsControl ItemsSource="{Binding Categories}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryRowViewModel">
              <Border Classes="card" Padding="12" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, Mode=TwoWay}"
                             Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Classes="icon"
                            Command="{Binding $parent[ItemsControl].((vm:CategoryManagerViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Delete category">
                      <controls:TwoToneIcon Data="{StaticResource ToneDelete}" SoftData="{StaticResource ToneDeleteSoft}" Foreground="{DynamicResource DangerInk}" Width="16" Height="16" />
                    </Button>
                  </Grid>
                  <TextBlock Classes="label" Text="{Binding UsageLabel}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card" Padding="12">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="ADD A CATEGORY" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Watermark="e.g. Indonesian"
                       Text="{Binding NewCategoryName, Mode=TwoWay}"
                       Margin="0,0,8,0">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding AddCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsConfirmingDelete}">
          <StackPanel Spacing="12">
            <controls:TwoToneIcon Data="{StaticResource ToneDelete}" SoftData="{StaticResource ToneDeleteSoft}" Foreground="{DynamicResource DangerInk}" Width="26" Height="26" />
            <TextBlock Classes="h3" Text="{Binding PendingDeleteMessage}" />
            <TextBlock Classes="muted" Text="The recipes stay in your cookbook." />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Keep it" Command="{Binding KeepCategoryCommand}" />
              <Button Classes="danger" Content="Delete" Command="{Binding DeleteConfirmedCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="18,10,18,14">
      <StackPanel Spacing="8">
        <TextBlock Classes="muted"
                   Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Classes="primary" Content="Save names" Command="{Binding SaveNamesCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
