<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:domain="using:Sedhep.Domain"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="760"
             x:Class="Sedhep.Views.CategoryManagerView"
             x:DataType="vm:CategoryManagerViewModel">
  <Grid Classes="page" RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="16" Spacing="12">
        <Button Classes="ghost"
                Content="‹ Cookbook"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left" />
        <TextBlock Classes="h2" Text="Categories" />
        <TextBlock Classes="muted"
                   Text="Rename a category and tap “Save names”. Deleting a category keeps its recipes — they move to “No category”." />

        <Border Classes="card">
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:Category">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBox Grid.Column="0"
                           Margin="0,0,8,0"
                           Text="{Binding Name, Mode=TwoWay}" />
                  <Button Grid.Column="1"
                          Classes="danger"
                          Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:CategoryManagerViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0"
                   Margin="0,0,8,0"
                   Watermark="New category name"
                   Text="{Binding NewCategoryName, Mode=TwoWay}" />
          <Button Grid.Column="1" Classes="primary" Content="Add" Command="{Binding AddCommand}" />
        </Grid>

        <Border Classes="card" IsVisible="{Binding IsConfirmingDelete}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h3" Text="{Binding PendingDeleteMessage}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="danger" Content="Delete category" Command="{Binding DeleteConfirmedCommand}" />
              <Button Classes="primary" Content="Keep it" Command="{Binding KeepCategoryCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="16,0,16,16" Spacing="10">
      <TextBlock Classes="muted"
                 Text="{Binding Status}"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Button Classes="primary" Content="Save names" Command="{Binding SaveNamesCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
