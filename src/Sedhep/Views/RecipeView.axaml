<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:domain="using:Sedhep.Domain"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.RecipeView"
             x:DataType="vm:RecipeViewModel">
  <Grid Background="{DynamicResource Page}" RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="18,14,18,20" Spacing="16">
        <!-- Leaving and sharing, always in the same place. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="icon" Command="{Binding BackCommand}" ToolTip.Tip="Back to cookbook">
            <Path Classes="icon" Data="{StaticResource IconChevronLeft}" />
          </Button>
          <Button Grid.Column="2" Classes="icon" Command="{Binding ShareCommand}" ToolTip.Tip="Send to a nearby phone">
            <Path Classes="icon" Data="{StaticResource IconShare}" />
          </Button>
        </Grid>

        <!-- The dish itself: a photo when there is one, a warm monogram when there is not. -->
        <Border Classes="cover" Height="200">
          <Panel>
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
            <Border Background="{DynamicResource SurfaceSunken}" IsVisible="{Binding !HasCover}">
              <Grid>
                <Path Classes="icon"
                      Data="{StaticResource IconPot}"
                      Width="70" Height="70"
                      Stroke="{DynamicResource BorderStrong}"
                      Opacity="0.5"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,26,22" />
                <TextBlock Text="{Binding Initial}"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentInk}"
                           Opacity="0.9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Panel>
        </Border>

        <StackPanel Spacing="10">
          <TextBlock Classes="display" Text="{Binding Recipe.Title}" />

          <WrapPanel>
            <Border Classes="pill" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon sm" Data="{StaticResource IconFolder}" />
                <TextBlock Classes="meta" Text="{Binding CategoryLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding HasTime}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon sm" Data="{StaticResource IconClock}" />
                <TextBlock Classes="meta" Text="{Binding TimeLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon sm" Data="{StaticResource IconPerson}" />
                <TextBlock Classes="meta" Text="{Binding ServingsLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill favorite" Margin="0,0,6,6" IsVisible="{Binding IsFavorite}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="icon sm" Data="{StaticResource IconStar}" Fill="{DynamicResource Favorite}" Stroke="{DynamicResource FavoriteInk}" />
                <TextBlock Classes="meta" Text="Favorite" Foreground="{DynamicResource FavoriteInk}" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <TextBlock Classes="body" Text="{Binding Recipe.Description}" IsVisible="{Binding HasDescription}" />
        </StackPanel>

        <!-- Ingredients read as a column of numbers first, names second. -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="INGREDIENTS" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Classes="meta"
                         Text="{Binding Recipe.Servings, StringFormat='{}{0} servings'}" />
            </Grid>

            <TextBlock Classes="muted" Text="No ingredients listed yet." IsVisible="{Binding !HasIngredients}" />

            <ItemsControl ItemsSource="{Binding Recipe.Ingredients}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:Ingredient">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                    <TextBlock Classes="body numeric"
                               MinWidth="78"
                               Margin="0,0,12,0"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Top">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} {1}">
                          <Binding Path="Quantity" />
                          <Binding Path="Unit" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Classes="body"
                               Text="{Binding Name}"
                               VerticalAlignment="Top" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Directions, one numbered circle per step. -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="DIRECTIONS" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="meta" Text="{Binding StepCountLabel}" />
            </Grid>

            <TextBlock Classes="muted" Text="No steps written yet." IsVisible="{Binding !HasSteps}" />

            <ItemsControl ItemsSource="{Binding Recipe.Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:RecipeStep">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <Border Width="28" Height="28" CornerRadius="14"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentSoft}">
                      <TextBlock Text="{Binding SortOrder}"
                                 FontSize="{DynamicResource FontMeta}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentInk}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Classes="body"
                               Text="{Binding Instruction}"
                               Margin="12,3,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Notes are the "remember this next time" part of a family recipe. -->
        <Border Classes="card" IsVisible="{Binding HasNotes}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="NOTES" />
            <TextBlock Classes="body" Text="{Binding Recipe.Notes}" />
          </StackPanel>
        </Border>

        <WrapPanel IsVisible="{Binding HasTags}">
          <ItemsControl ItemsSource="{Binding Recipe.Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Border Classes="pill" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon sm" Data="{StaticResource IconTag}" />
                    <TextBlock Classes="meta" Text="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <TextBlock Classes="muted"
                   Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- The action bar stays put while the recipe scrolls. -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="18,12,18,14">
      <StackPanel Spacing="10">
        <Button Classes="primary" Command="{Binding CookCommand}" IsVisible="{Binding HasSteps}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon onAccent" Data="{StaticResource IconPlay}" Fill="{DynamicResource OnAccent}" />
            <TextBlock Text="Start cooking" VerticalAlignment="Center" Foreground="{DynamicResource OnAccent}" />
          </StackPanel>
        </Button>

        <Grid ColumnDefinitions="*,*,*,*" >
          <Button Grid.Column="0" Classes="bare" Command="{Binding ToggleFavoriteCommand}" Margin="0,2,0,2">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <Path Classes="icon"
                    Classes.favorite="{Binding IsFavorite}"
                    Data="{StaticResource IconStar}"
                    HorizontalAlignment="Center" />
              <TextBlock Classes="meta" Text="{Binding FavoriteLabel}" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Classes="bare" Command="{Binding EditCommand}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconPencil}" HorizontalAlignment="Center" />
              <TextBlock Classes="meta" Text="Edit" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2" Classes="bare" Command="{Binding ShareCommand}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconShare}" HorizontalAlignment="Center" />
              <TextBlock Classes="meta" Text="Share" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="3" Classes="bare" Command="{Binding DeleteCommand}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <Path Classes="icon" Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerInk}" HorizontalAlignment="Center" />
              <TextBlock Classes="meta" Text="Delete" HorizontalAlignment="Center" Foreground="{DynamicResource DangerInk}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Deleting asks once, in place, with the safe choice on the right. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            IsVisible="{Binding IsConfirmingDelete}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="24" Padding="20" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Path Classes="icon lg" Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerInk}" />
          <TextBlock Classes="h2" Text="Delete this recipe?" />
          <TextBlock Classes="muted" Text="It disappears from this device for good. This cannot be undone." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="Keep it" Command="{Binding KeepRecipeCommand}" />
            <Button Classes="danger" Content="Delete" Command="{Binding DeleteConfirmedCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
