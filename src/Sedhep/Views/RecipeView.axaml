<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:domain="using:Sedhep.Domain"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.RecipeView"
             x:DataType="vm:RecipeViewModel"
             xmlns:controls="clr-namespace:Sedhep.Controls">
  <Grid Background="{DynamicResource Page}" RowDefinitions="*,Auto">
    <Grid.Styles>
      <Style Selector="Border.recipeSection">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="18" />
      </Style>
    </Grid.Styles>

    <ScrollViewer Grid.Row="0">
      <StackPanel Margin="22,20,22,22" Spacing="18" MaxWidth="760" HorizontalAlignment="Center">

        <!-- The dish itself: a photograph when there is one, otherwise the recipe's own colours. -->
        <Border Classes="cover" Height="240">
          <Panel>
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />

            <Panel Background="{Binding CoverBackground}" IsVisible="{Binding !HasCover}">
              <TextBlock Text="{Binding Initial}"
                         FontSize="104"
                         FontWeight="Bold"
                         Foreground="{Binding CoverInk}"
                         Opacity="0.9"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Panel>

            <!-- Leaving and sharing, floating over the cover so the recipe starts at the dish. -->
            <Button Classes="icon"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Back"
                    ToolTip.Tip="Back to cookbook"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12">
              <controls:TwoToneIcon Data="{StaticResource ToneChevronLeft}" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" />
            </Button>
            <!-- Everything the recipe can do besides cooking, behind one button. -->
            <Button x:Name="ActionsButton"
                    Classes="icon"
                    AutomationProperties.Name="Recipe actions"
                    ToolTip.Tip="More actions"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12">
              <controls:TwoToneIcon Data="{StaticResource ToneMoreVert}" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" />

              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="menu">
                  <Border Classes="menuCard">
                    <StackPanel Spacing="2">
                      <Button Classes="menuItem"
                              Command="{Binding ToggleFavoriteCommand}"
                              Click="OnMenuAction"
                              AutomationProperties.Name="Favorite">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="menuGlyph">
                            <controls:TwoToneIcon Data="{StaticResource ToneStar}"
                                                  SoftData="{StaticResource ToneStarSoft}"
                                                  Classes.favorite="{Binding IsFavorite}"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="Favorite"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>

                      <Button Classes="menuItem"
                              Command="{Binding EditCommand}"
                              Click="OnMenuAction"
                              AutomationProperties.Name="Edit recipe">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="menuGlyph">
                            <controls:TwoToneIcon Data="{StaticResource ToneEdit}"
                                                  SoftData="{StaticResource ToneEditSoft}"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="Edit"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>

                      <Button Classes="menuItem"
                              Command="{Binding ShareCommand}"
                              Click="OnMenuAction"
                              AutomationProperties.Name="Share recipe">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="menuGlyph">
                            <controls:TwoToneIcon Data="{StaticResource ToneIosShare}"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="Share"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>

                      <Button Classes="menuItem"
                              Command="{Binding DeleteCommand}"
                              Click="OnMenuAction"
                              AutomationProperties.Name="Delete recipe">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="menuGlyph danger">
                            <controls:TwoToneIcon Data="{StaticResource ToneDelete}"
                                                  SoftData="{StaticResource ToneDeleteSoft}"
                                                  Foreground="{DynamicResource DangerInk}"
                                                  Width="18" Height="18"
                                                  HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Grid.Column="1"
                                     Text="Delete"
                                     Margin="12,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource DangerInk}" />
                        </Grid>
                      </Button>
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Panel>
        </Border>

        <StackPanel Spacing="10">
          <TextBlock Classes="display" Text="{Binding Recipe.Title}" />

          <WrapPanel>
            <Border Classes="pill" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:TwoToneIcon Data="{StaticResource ToneFolder}" SoftData="{StaticResource ToneFolderSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                <TextBlock Classes="meta" Text="{Binding CategoryLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill" Margin="0,0,6,6" IsVisible="{Binding HasTime}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:TwoToneIcon Data="{StaticResource ToneSchedule}" SoftData="{StaticResource ToneScheduleSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                <TextBlock Classes="meta" Text="{Binding TimeLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:TwoToneIcon Data="{StaticResource TonePerson}" SoftData="{StaticResource TonePersonSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                <TextBlock Classes="meta" Text="{Binding ServingsLabel}" />
              </StackPanel>
            </Border>
            <Border Classes="pill favorite" Margin="0,0,6,6" IsVisible="{Binding IsFavorite}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <controls:TwoToneIcon Data="{StaticResource ToneStar}" SoftData="{StaticResource ToneStarSoft}" Foreground="{DynamicResource FavoriteInk}" Width="16" Height="16" />
                <TextBlock Classes="meta" Text="Favorite" Foreground="{DynamicResource FavoriteInk}" />
              </StackPanel>
            </Border>
          </WrapPanel>

          <!-- Prose keeps a readable measure; the cards around it may use the whole column. -->
          <TextBlock Classes="body"
                     MaxWidth="620"
                     HorizontalAlignment="Left"
                     Text="{Binding Recipe.Description}"
                     IsVisible="{Binding HasDescription}" />
        </StackPanel>

        <!-- Ingredients and method: stacked on a phone, side by side on a desk. -->
        <Grid x:Name="MethodGrid"
              ColumnDefinitions="*"
              RowDefinitions="Auto,Auto">
          <!-- Ingredients read as a warm list you can glance at with wet hands. -->
          <Border x:Name="IngredientsCard"
                  Classes="recipeSection"
                  Background="{DynamicResource SurfaceWarm}"
                  BorderThickness="0">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="INGREDIENTS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Classes="meta"
                           Text="{Binding Recipe.Servings, StringFormat='{}{0} servings'}" />
              </Grid>

              <TextBlock Classes="muted" Text="No ingredients listed yet." IsVisible="{Binding !HasIngredients}" />

              <ItemsControl ItemsSource="{Binding Recipe.Ingredients}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="domain:Ingredient">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                      <TextBlock Classes="body numeric"
                                 MinWidth="72"
                                 Margin="0,0,12,0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 VerticalAlignment="Top">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="Quantity" />
                            <Binding Path="Unit" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                      <TextBlock Grid.Column="1"
                                 Classes="body"
                                 Text="{Binding Name}"
                                 VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Directions, one numbered circle per step. -->
          <Border x:Name="DirectionsCard" Grid.Row="1" Classes="recipeSection">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="DIRECTIONS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding StepCountLabel}" />
              </Grid>

              <TextBlock Classes="muted" Text="No steps written yet." IsVisible="{Binding !HasSteps}" />

              <ItemsControl ItemsSource="{Binding Recipe.Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="domain:RecipeStep">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                      <Border Width="30" Height="30" CornerRadius="999"
                              VerticalAlignment="Top"
                              Background="{DynamicResource AccentSoft}">
                        <TextBlock Text="{Binding SortOrder}"
                                   FontSize="{DynamicResource FontMeta}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentInk}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Classes="body"
                                 MaxWidth="620"
                                 HorizontalAlignment="Left"
                                 Text="{Binding Instruction}"
                                 Margin="12,3,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Notes are the "remember this next time" part of a family recipe. -->
        <Border Classes="recipeSection" IsVisible="{Binding HasNotes}" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="NOTES" />
            <TextBlock Classes="body"
                       MaxWidth="620"
                       HorizontalAlignment="Left"
                       Text="{Binding Recipe.Notes}" />
          </StackPanel>
        </Border>

        <WrapPanel IsVisible="{Binding HasTags}">
          <ItemsControl ItemsSource="{Binding Recipe.Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <Border Classes="pill" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <controls:TwoToneIcon Data="{StaticResource ToneLabel}" SoftData="{StaticResource ToneLabelSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                    <TextBlock Classes="meta" Text="{Binding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <TextBlock Classes="muted"
                   Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- The one action the recipe is for, held still while the page scrolls. -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="0,1,0,0"
            Padding="18,12,18,14">
      <Button Classes="primary"
              Command="{Binding CookCommand}"
              AutomationProperties.Name="Start cooking"
              IsVisible="{Binding HasSteps}"
              MaxWidth="760"
              HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:TwoToneIcon Data="{StaticResource TonePlayArrow}" SoftData="{StaticResource TonePlayArrowSoft}" Foreground="{DynamicResource OnAccent}" Width="20" Height="20" />
          <TextBlock Text="Start cooking" VerticalAlignment="Center" Foreground="{DynamicResource OnAccent}" />
        </StackPanel>
      </Button>
    </Border>

    <!-- Deleting asks once, in place, with the safe choice on the right. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            IsVisible="{Binding IsConfirmingDelete}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="24" Padding="20" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="14">
          <controls:TwoToneIcon Data="{StaticResource ToneDelete}" SoftData="{StaticResource ToneDeleteSoft}" Foreground="{DynamicResource DangerInk}" Width="26" Height="26" />
          <TextBlock Classes="h2" Text="Delete this recipe?" />
          <TextBlock Classes="muted" Text="It disappears from this device for good. This cannot be undone." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="Keep it" Command="{Binding KeepRecipeCommand}" />
            <Button Classes="danger" Content="Delete" Command="{Binding DeleteConfirmedCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
