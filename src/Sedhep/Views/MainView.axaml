<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:controls="clr-namespace:Sedhep.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="760"
             x:Class="Sedhep.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource Page}">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,20,22,10" Spacing="15" MaxWidth="980" HorizontalAlignment="Center">

        <!-- The bookplate: who this cookbook belongs to. Writing lives in the navigation. -->
        <StackPanel Spacing="3">
          <TextBlock Classes="brand" Text="Sedhep" />
          <TextBlock Classes="muted" Text="{Binding HeaderSubtitle}" />
        </StackPanel>

        <!-- Search works entirely offline; it reads the local database. -->
        <Grid>
          <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                   Watermark="Search recipes, ingredients, notes…"
                   Padding="44,11,44,11" />
          <controls:TwoToneIcon Classes="sm"
                                Data="{StaticResource ToneSearch}"
                                Foreground="{DynamicResource TextTertiary}"
                                Margin="15,0,0,0"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
          <Button Classes="bare"
                  Width="34" Height="34"
                  Margin="0,0,8,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsSearching}"
                  Command="{Binding ClearSearchCommand}"
                  ToolTip.Tip="Clear search">
            <controls:TwoToneIcon Classes="sm"
                                  Data="{StaticResource ToneClose}"
                                  Foreground="{DynamicResource TextTertiary}" />
          </Button>
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="title" Text="{Binding HeaderTitle}" VerticalAlignment="Bottom" />
          <TextBlock Grid.Column="1"
                     Classes="meta"
                     Text="{Binding CountLabel}"
                     VerticalAlignment="Bottom"
                     Margin="0,0,2,4" />
        </Grid>

        <!-- Shelves, as a row of discs rather than another list to read. -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="h3" Text="Browse the shelves" VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="link"
                  Content="Manage"
                  Command="{Binding ManageCategoriesCommand}"
                  ToolTip.Tip="Rename, add or remove categories" />
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding CategoryFilters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryFilterViewModel">
                <Button Classes="bare"
                        Command="{Binding SelectCommand}"
                        CommandParameter="{Binding}"
                        Margin="0,0,6,0"
                        ToolTip.Tip="{Binding Name}">
                  <StackPanel Width="70" Spacing="6">
                    <Border Classes="shelfDisc"
                            Classes.active="{Binding IsActive}"
                            Background="{Binding Wash}">
                      <TextBlock Text="{Binding Initial}"
                                 FontSize="21"
                                 FontWeight="Bold"
                                 Foreground="{Binding Ink}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Name}"
                               FontSize="{DynamicResource FontLabel}"
                               MaxLines="2"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- How the shelf is ordered. -->
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Button Classes="sort" Classes.active="{Binding IsSortRecent}" Content="Recent" Command="{Binding SortRecentCommand}" />
          <Button Classes="sort" Classes.active="{Binding IsSortNewest}" Content="Newest" Command="{Binding SortNewestCommand}" />
          <Button Classes="sort" Classes.active="{Binding IsSortTitle}" Content="A–Z" Command="{Binding SortByTitleCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The empty cookbook, or the empty result of a filter. -->
    <StackPanel Grid.Row="1"
                IsVisible="{Binding IsEmpty}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                Margin="34,10,34,30"
                MaxWidth="340">
      <Border Width="92" Height="92" CornerRadius="999" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
        <controls:TwoToneIcon Data="{StaticResource ToneSoupKitchen}" SoftData="{StaticResource ToneSoupKitchenSoft}" Foreground="{DynamicResource AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" />
      </Border>
      <TextBlock Classes="h2" Text="{Binding EmptyTitle}" TextAlignment="Center" />
      <TextBlock Classes="muted" Text="{Binding EmptyMessage}" TextAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
        <Button Classes="primary"
                Content="Write a recipe"
                IsVisible="{Binding ShowWriteCta}"
                Command="{Binding NewRecipeCommand}" />
        <Button Classes="outline"
                Content="Clear search"
                IsVisible="{Binding IsSearching}"
                Command="{Binding ClearSearchCommand}" />
      </StackPanel>
    </StackPanel>

    <!-- One cover card per recipe, laid out like a shelf of little books. -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Recipes}"
                    Margin="14,2,14,16"
                    MaxWidth="980"
                    HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemWidth="170" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecipeCardViewModel">
            <Button Classes="bare"
                    Margin="0,0,10,14"
                    AutomationProperties.Name="{Binding Title}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenRecipeCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Spacing="10">
                <Border Classes="cover" Height="120" Background="{Binding CoverBackground}"
                        BoxShadow="0 10 22 -16 #40264653">
                  <Grid>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />

                    <!-- No photograph: the recipe's own colours and its initial. -->
                    <TextBlock Text="{Binding Initial}"
                               IsVisible="{Binding !HasCover}"
                               FontSize="46"
                               FontWeight="Bold"
                               Foreground="{Binding CoverInk}"
                               Opacity="0.9"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Border Width="30" Height="30"
                            CornerRadius="999"
                            Background="{DynamicResource Surface}"
                            IsVisible="{Binding IsFavorite}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8">
                      <controls:TwoToneIcon Width="17" Height="17"
                                            Data="{StaticResource ToneStar}"
                                            SoftData="{StaticResource ToneStarSoft}"
                                            Foreground="{DynamicResource FavoriteInk}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>

                <!-- Two lines are always reserved for the title, so a wrapped name cannot push
                     the meta line out of line with the cards beside it. -->
                <StackPanel Spacing="5" Margin="2,0,2,0">
                  <TextBlock Classes="h3"
                             Text="{Binding Title}"
                             MinHeight="46"
                             VerticalAlignment="Top"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="meta"
                             Text="{Binding MetaLine}"
                             MaxLines="1"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2"
            Classes="toast"
            Margin="16,0,16,12"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="muted" Text="{Binding Status}" />
    </Border>

  </Grid>

  <UserControl.Styles>
    <!-- A category disc, lifted with a ring when it is the shelf being shown. -->
    <Style Selector="Border.shelfDisc">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="62" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.shelfDisc.active">
      <Setter Property="BorderBrush" Value="{DynamicResource Ink}" />
    </Style>
  </UserControl.Styles>
</UserControl>
