<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:controls="clr-namespace:Sedhep.Controls"
             x:Class="Sedhep.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <!--
    Phone: a floating tray of the four places you can be, with writing a recipe raised in the middle.
    Desk: the same list in a rail, standing open like a book's table of contents.
  -->
  <!-- Columns: rail, collection, the divider you can drag, the reading pane. -->
  <Grid RowDefinitions="*,Auto" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="0" />
      <ColumnDefinition Width="Auto" />
      <!-- A little narrower than the collection, so the shelves stay the wider half. -->
      <ColumnDefinition Width="0.95*" MinWidth="280" MaxWidth="760" />
    </Grid.ColumnDefinitions>

    <!-- The rail. A paper card that never moves, so finding your way back is chrome, not a step. -->
    <Border Grid.Row="0"
            Grid.Column="0"
            Width="244"
            IsVisible="{Binding IsRailVisible}"
            Margin="14,14,0,14"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="16,20,16,16">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- The imprint: which book is open. -->
        <Grid ColumnDefinitions="Auto,*" Margin="2,0,0,0">
          <Border Width="40" Height="40"
                  CornerRadius="13"
                  ClipToBounds="True"
                  Background="{DynamicResource AccentSoft}">
            <Image Source="avares://Sedhep/Assets/app-icon.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="brand" FontSize="25" LineHeight="27" Text="Sedhep" />
            <TextBlock Classes="data" FontSize="11" Text="Heritage proven" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="divider" Margin="2,18,2,16" />

        <!-- The one thing a cookbook is for, given the only filled button in the rail. -->
        <Button Grid.Row="2"
                Classes="newRecipe"
                Command="{Binding NewRecipeCommand}"
                AutomationProperties.Name="New Recipe"
                ToolTip.Tip="Write a new recipe">
          <Grid ColumnDefinitions="Auto,*">
            <controls:TwoToneIcon Data="{StaticResource ToneAddCircle}"
                                  SoftData="{StaticResource ToneAddCircleSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}" />
            <TextBlock Grid.Column="1"
                       Classes="navLabel"
                       Text="New Recipe"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </Button>

        <StackPanel Grid.Row="3" Margin="0,8,0,0" Spacing="8">
          <Button Classes="rail"
                  Classes.active="{Binding IsCookbookTab}"
                  Command="{Binding ShowCookbookTabCommand}"
                  AutomationProperties.Name="Cookbook"
                  ToolTip.Tip="Everything you have cooked">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:TwoToneIcon Data="{StaticResource ToneBookmark}"
                                    SoftData="{StaticResource ToneBookmarkSoft}"
                                    Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Classes="navLabel" Text="Cookbook" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="rail"
                  Classes.active="{Binding IsFavoritesTab}"
                  Command="{Binding ShowFavoritesTabCommand}"
                  AutomationProperties.Name="Favorites"
                  ToolTip.Tip="Only the recipes you starred">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:TwoToneIcon Data="{StaticResource ToneStar}"
                                    SoftData="{StaticResource ToneStarSoft}"
                                    Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Classes="navLabel" Text="Favorites" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="rail"
                  Classes.active="{Binding IsAlmanacTab}"
                  Command="{Binding ShowAlmanacTabCommand}"
                  AutomationProperties.Name="Almanac"
                  ToolTip.Tip="Every ingredient, on its own card">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <controls:TwoToneIcon Data="{StaticResource ToneEco}"
                                    SoftData="{StaticResource ToneEcoSoft}"
                                    Foreground="{Binding $parent[Button].Foreground}" />
              <TextBlock Classes="navLabel" Text="Almanac" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Preferences live apart from the cookbook, at the foot of the rail. -->
        <Button Grid.Row="4"
                Classes="rail"
                Classes.active="{Binding IsSettingsTab}"
                Command="{Binding ShowSettingsTabCommand}"
                AutomationProperties.Name="Settings"
                ToolTip.Tip="Appearance, cookbook folder and sharing">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:TwoToneIcon Data="{StaticResource ToneSettings}"
                                  SoftData="{StaticResource ToneSettingsSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}" />
            <TextBlock Classes="navLabel" Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- The cookbook and reading pane share the available space on tablet and desktop. -->
    <ContentControl Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="{Binding MainContentColumnSpan}"
                    Content="{Binding Current}"
                    HorizontalAlignment="Stretch"
                    MinWidth="0" />

    <!-- The divider between the shelves and a recipe: a hairline that is also a drag handle. -->
    <Border Grid.Row="0"
            Grid.Column="2"
            Width="1"
            HorizontalAlignment="Center"
            Background="{DynamicResource Border}"
            IsVisible="{Binding IsSplitViewVisible}" />

    <GridSplitter Grid.Row="0"
                  Grid.Column="2"
                  Width="9"
                  ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext"
                  Background="Transparent"
                  Cursor="SizeWestEast"
                  IsVisible="{Binding IsSplitViewVisible}"
                  AutomationProperties.Name="Resize the reading pane"
                  ToolTip.Tip="Drag to resize the reading pane" />

    <Border Grid.Row="0"
            Grid.Column="3"
            IsVisible="{Binding IsSplitViewVisible}"
            Background="{DynamicResource Page}">
      <Grid>
        <ContentControl Content="{Binding SelectedRecipe}"
                        IsVisible="{Binding HasSelectedRecipe}"
                        HorizontalAlignment="Stretch"
                        MaxWidth="720" />
        <StackPanel IsVisible="{Binding !HasSelectedRecipe}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="300"
                    Margin="28"
                    Spacing="12">
          <Border Width="70" Height="70" CornerRadius="999"
                  Background="{DynamicResource AccentSoft}"
                  HorizontalAlignment="Center">
            <controls:TwoToneIcon Classes="lg"
                                  Data="{StaticResource ToneBookmark}"
                                  SoftData="{StaticResource ToneBookmarkSoft}"
                                  Foreground="{DynamicResource AccentInk}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="h2" Text="Your cookbook, at a glance" TextAlignment="Center" />
          <TextBlock Classes="muted" Text="Choose a recipe to read its ingredients and method."
                     TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!--
      Puts the reading pane away, or pulls it back out. One glyph, two states: the sidebar
      column is washed in while the pane stands beside the collection, and left empty once it
      is put away. The tooltip carries the wording, so the button stays the size of an icon.
    -->
    <Button Grid.Row="0"
            Grid.Column="1"
            Classes="icon"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            IsVisible="{Binding IsPreviewToggleVisible}"
            Command="{Binding TogglePreviewCommand}"
            AutomationProperties.Name="{Binding PreviewToggleHint}"
            ToolTip.Tip="{Binding PreviewToggleHint}">
      <Panel>
        <controls:TwoToneIcon Data="{StaticResource ToneViewSidebar}"
                              SoftData="{StaticResource ToneViewSidebarSoft}"
                              Foreground="{DynamicResource TextSecondary}"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsPreviewOpen}" />
        <controls:TwoToneIcon Data="{StaticResource ToneViewSidebar}"
                              Foreground="{DynamicResource TextTertiary}"
                              Width="20" Height="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !IsPreviewOpen}" />
      </Panel>
    </Button>

    <!-- Status of the last transfer, kept out of the way until there is something to say. -->
    <Border Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="3"
            Classes="toast"
            Margin="16,0,16,12"
            VerticalAlignment="Bottom"
            IsVisible="{Binding OfferStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="muted" Text="{Binding OfferStatus}" />
    </Border>

    <!--
      Bottom bar: the same four places, floating over the page like a tray. The create button sits
      in its own column and breaks the top edge, so it is found by feel rather than by reading.
    -->
    <Border Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Margin="12,0,12,12"
            MaxWidth="560"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="26"
            Padding="6"
            BoxShadow="0 14 30 -22 #55264653">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="IsTabBarVisible" />
          <Binding Path="IsCollectionTabBarVisible" />
        </MultiBinding>
      </Border.IsVisible>
      <!--
        Five slots: four equal ones for the destinations and a fixed one in the middle for the
        raised create button. The fixed width keeps the four tabs exactly even and the button
        exactly on the bar's centre line, whatever the label widths are.
      -->
      <Grid ColumnDefinitions="*,*,64,*,*">
        <Button Grid.Column="0"
                Classes="tab"
                Classes.active="{Binding IsCookbookTab}"
                Command="{Binding ShowCookbookTabCommand}"
                AutomationProperties.Name="Cookbook"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <controls:TwoToneIcon Data="{StaticResource ToneBookmark}"
                                  SoftData="{StaticResource ToneBookmarkSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}"
                                  HorizontalAlignment="Center" />
            <TextBlock Classes="tabLabel" Text="Cookbook" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="1"
                Classes="tab"
                Classes.active="{Binding IsFavoritesTab}"
                Command="{Binding ShowFavoritesTabCommand}"
                AutomationProperties.Name="Favorites"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <controls:TwoToneIcon Data="{StaticResource ToneStar}"
                                  SoftData="{StaticResource ToneStarSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}"
                                  HorizontalAlignment="Center" />
            <TextBlock Classes="tabLabel" Text="Favorites" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="2"
                Classes="create"
                Command="{Binding NewRecipeCommand}"
                AutomationProperties.Name="New Recipe"
                ToolTip.Tip="New recipe"
                Margin="0,-25,0,0">
          <controls:TwoToneIcon Data="{StaticResource ToneAddCircle}"
                                SoftData="{StaticResource ToneAddCircleSoft}"
                                Width="30" Height="30"
                                Foreground="{Binding $parent[Button].Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        </Button>

        <Button Grid.Column="3"
                Classes="tab"
                Classes.active="{Binding IsAlmanacTab}"
                Command="{Binding ShowAlmanacTabCommand}"
                AutomationProperties.Name="Almanac"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <controls:TwoToneIcon Data="{StaticResource ToneEco}"
                                  SoftData="{StaticResource ToneEcoSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}"
                                  HorizontalAlignment="Center" />
            <TextBlock Classes="tabLabel" Text="Almanac" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="4"
                Classes="tab"
                Classes.active="{Binding IsSettingsTab}"
                Command="{Binding ShowSettingsTabCommand}"
                AutomationProperties.Name="Settings"
                HorizontalAlignment="Stretch">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <controls:TwoToneIcon Data="{StaticResource ToneSettings}"
                                  SoftData="{StaticResource ToneSettingsSoft}"
                                  Foreground="{Binding $parent[Button].Foreground}"
                                  HorizontalAlignment="Center" />
            <TextBlock Classes="tabLabel" Text="Settings" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- An arriving transfer is a deliberate interruption: it is never accepted automatically. -->
    <Border Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            IsVisible="{Binding HasIncomingOffer}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="24" Padding="20" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="14">
          <Border Classes="pill accent" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:TwoToneIcon Data="{StaticResource ToneWifiTethering}" Foreground="{DynamicResource AccentInk}" Width="16" Height="16" />
              <TextBlock Classes="label" Text="RECIPE ARRIVING" Foreground="{DynamicResource AccentInk}" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="{Binding IncomingOffer.DeviceName}" />
            <TextBlock Classes="muted" Text="{Binding IncomingOffer.Summary}" />
            <TextBlock Classes="muted"
                       Text="{Binding IncomingOffer.RecipeCount, StringFormat='{}{0} recipes, encrypted on the way'}" />
          </StackPanel>
          <TextBlock Classes="muted"
                     Text="Only accept transfers from someone in the room with you." />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary"
                    Content="Accept"
                    Command="{Binding AcceptOfferCommand}"
                    HorizontalAlignment="Stretch" />
            <Button Classes="outline" Content="No thanks" Command="{Binding DeclineOfferCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Existing recipes are protected until the recipient explicitly chooses a copy. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            Grid.Column="0" Grid.ColumnSpan="4"
            IsVisible="{Binding HasPendingIncomingConflict}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="24" Padding="20" VerticalAlignment="Center" MaxWidth="440">
        <StackPanel Spacing="14">
          <Border Classes="pill accent" HorizontalAlignment="Left">
            <TextBlock Classes="label" Text="SAME RECIPE, TWO VERSIONS" Foreground="{DynamicResource AccentInk}" />
          </Border>
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="{Binding PendingIncomingConflict.Title}" />
            <TextBlock Classes="muted" Text="{Binding IncomingConflictDetails}" />
          </StackPanel>
          <TextBlock Classes="muted" Text="Nothing is replaced until you choose. Keep your copy or use the one that arrived." />
          <StackPanel Spacing="8">
            <Button Classes="primary" Content="Keep my version" HorizontalAlignment="Stretch"
                    Command="{Binding KeepLocalIncomingConflictCommand}" />
            <Button Classes="outline" Content="Use the incoming version" HorizontalAlignment="Stretch"
                    Command="{Binding UseIncomingConflictCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
