<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.CookingModeView"
             Focusable="True"
             x:DataType="vm:CookingModeViewModel">
  <Grid Background="{DynamicResource Page}" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
    <!-- Nothing on this screen competes with the step. -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,12,14,0">
      <Button Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Back to the recipe">
        <Path Classes="icon" Data="{StaticResource IconClose}" />
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
        <TextBlock Classes="meta"
                   Text="{Binding Recipe.Title}"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxLines="1" />
        <TextBlock Classes="label"
                   Text="{Binding StepLabel}"
                   HorizontalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="2"
              Classes="icon"
              Command="{Binding ToggleIngredientsCommand}"
              ToolTip.Tip="Show ingredients">
        <Path Classes="icon" Data="{StaticResource IconBook}" />
      </Button>
    </Grid>

    <ProgressBar Grid.Row="1"
                 Margin="16,12,16,0"
                 Minimum="0" Maximum="100"
                 Value="{Binding ProgressPercent}"
                 IsVisible="{Binding HasSteps}" />

    <!-- One step, as large as the screen allows. -->
    <Border Grid.Row="2" Classes="card" Margin="16,14,16,0" Padding="22" VerticalAlignment="Stretch">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentStep.Instruction}"
                     FontSize="{DynamicResource FontCook}"
                     LineHeight="38"
                     FontWeight="Medium"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimary}" />
          <TextBlock Classes="muted"
                     Text="This recipe has no steps written yet. Go back and add them in the editor."
                     IsVisible="{Binding !HasSteps}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Timer for steps that carry one: the one place in the app that glows Burly Wood.
         Steps advance with the arrow keys, PageUp/PageDown, Space, and Esc goes back. -->
    <Border Grid.Row="3"
            Classes="flat"
            Background="{DynamicResource HighlightSoft}"
            Margin="16,10,16,0"
            IsVisible="{Binding HasTimer}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Classes="icon"
              Data="{StaticResource IconTimer}"
              Stroke="{DynamicResource HighlightInk}"
              VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="{Binding TimerTitle}" Foreground="{DynamicResource HighlightInk}" />
          <TextBlock Classes="h3" Text="{Binding TimerLabel, TargetNullValue='Ready'}" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="outline"
                MinHeight="38"
                Padding="14,6"
                Content="{Binding TimerButtonLabel}"
                Command="{Binding ToggleTimerCommand}" />
      </Grid>
    </Border>

    <!-- Ingredients, kept in view but out of the way. -->
    <Border Grid.Row="4" Classes="card" Margin="16,10,16,0" Padding="14" IsVisible="{Binding AreIngredientsVisible}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="INGREDIENTS" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="meta" Text="{Binding IngredientCountLabel}" />
        </Grid>
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Ingredients}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CookIngredientViewModel">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,4">
                  <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontBody}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} {1}">
                        <Binding Path="QuantityLabel" />
                        <Binding Path="Name" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Grid Grid.Row="5" ColumnDefinitions="*,*" Margin="16,12,16,16">
      <Button Grid.Column="0"
              Classes="outline"
              MinHeight="56"
              Margin="0,0,5,0"
              HorizontalAlignment="Stretch"
              FontSize="{DynamicResource FontH3}"
              Content="Previous"
              Command="{Binding PreviousCommand}"
              IsEnabled="{Binding CanGoPrevious}" />
      <Button Grid.Column="1"
              Classes="primary"
              MinHeight="56"
              Margin="5,0,0,0"
              HorizontalAlignment="Stretch"
              FontSize="{DynamicResource FontH3}"
              Content="{Binding NextLabel}"
              Command="{Binding NextCommand}" />
    </Grid>
  </Grid>
</UserControl>
