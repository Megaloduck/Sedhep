<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             xmlns:domain="using:Sedhep.Domain"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.ShareView"
             x:DataType="vm:ShareViewModel"
             xmlns:controls="clr-namespace:Sedhep.Controls">
  <Grid Background="{DynamicResource Page}" RowDefinitions="Auto,*">
    <Border Padding="12,12,12,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="icon" Command="{Binding BackCommand}" AutomationProperties.Name="Back" ToolTip.Tip="Back">
          <controls:TwoToneIcon Data="{StaticResource ToneChevronLeft}" Foreground="{DynamicResource TextSecondary}" Width="20" Height="20" />
        </Button>
        <TextBlock Grid.Column="1" Classes="h2" Text="Share &amp; backup" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Grid.Column="2" Width="42" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="18,6,18,24" Spacing="14">
        <!-- What will be sent -->
        <Border Classes="card" IsVisible="{Binding HasSingleRecipe}">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="WHAT TO SEND" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0"
                      Classes="chip"
                      Margin="0,0,4,0"
                      Classes.active="{Binding ShareSingle}"
                      Content="{Binding SingleRecipeLabel}"
                      Command="{Binding ChooseSingleCommand}" />
              <Button Grid.Column="1"
                      Classes="chip"
                      Margin="4,0,0,0"
                      Classes.active="{Binding IsCookbookScope}"
                      Content="Whole cookbook"
                      Command="{Binding ChooseCookbookCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="{Binding ScopeHint}" />
          </StackPanel>
        </Border>

        <!-- Nearby phones -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="NEARBY PHONES" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="bare" Command="{Binding RefreshNearbyCommand}">
                <TextBlock Classes="meta" Text="Look again" Foreground="{DynamicResource AccentInk}" />
              </Button>
            </Grid>

            <StackPanel Spacing="6" IsVisible="{Binding !HasDevices}">
              <Grid ColumnDefinitions="Auto,*">
                <controls:TwoToneIcon Data="{StaticResource ToneWifiTethering}" Foreground="{DynamicResource AccentInk}" Width="20" Height="20" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="body" Text="Looking for phones on this Wi-Fi…" IsVisible="{Binding IsLooking}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="body" Text="No phones found yet." IsVisible="{Binding !IsLooking}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="muted"
                         Text="Open Sedhep on the other phone and keep it on this screen. Both devices need to be on the same Wi-Fi." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:NearbyDevice">
                  <Border Classes="flat" Margin="0,0,0,8" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource Surface}">
                        <controls:TwoToneIcon Data="{StaticResource ToneWifiTethering}" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="h3" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock Classes="meta" Text="Ready to receive" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="primary"
                              MinHeight="38"
                              Padding="16,6"
                              Content="Send"
                              Command="{Binding $parent[ItemsControl].((vm:ShareViewModel)DataContext).SendToCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="8" IsVisible="{Binding IsSending}">
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
              <TextBlock Classes="muted" Text="{Binding Status}" />
            </StackPanel>

            <TextBlock Classes="muted"
                       Text="The other phone must accept before anything is sent. The transfer is encrypted on the way."
                       IsVisible="{Binding !IsSending}" />
          </StackPanel>
        </Border>

        <!-- QR code: the transfer that still works when the Wi-Fi list comes up empty -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="QR CODE" />
            <TextBlock Classes="muted"
                       Text="When two phones cannot find each other on the Wi-Fi, a code carried from one screen to the other still works." />

            <Button Classes="outline"
                    Command="{Binding ShowQrCodeCommand}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Show my code to receive">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:TwoToneIcon Data="{StaticResource ToneQrCode2}"
                                      Foreground="{DynamicResource TextSecondary}"
                                      Width="16" Height="16" />
                <TextBlock Text="Show my code to receive" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="outline"
                    Command="{Binding ScanQrCodeCommand}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Scan a code to send">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:TwoToneIcon Data="{StaticResource TonePhotoCamera}"
                                      SoftData="{StaticResource TonePhotoCameraSoft}"
                                      Foreground="{DynamicResource TextSecondary}"
                                      Width="16" Height="16" />
                <TextBlock Text="Scan a code to send" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- Files -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="COOKBOOK FILE" />
            <TextBlock Classes="muted"
                       Text="A .cookbook file holds your recipes and photos. Use it for a backup, for moving to a new phone, or to keep a copy somewhere safe." />

            <Button Classes="outline" Command="{Binding ExportFileCommand}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:TwoToneIcon Data="{StaticResource ToneDownload}" SoftData="{StaticResource ToneDownloadSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                <TextBlock Text="Save the cookbook to a file" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="outline" Command="{Binding ImportFileCommand}" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:TwoToneIcon Data="{StaticResource ToneFolder}" SoftData="{StaticResource ToneFolderSoft}" Foreground="{DynamicResource TextSecondary}" Width="16" Height="16" />
                <TextBlock Text="Open a cookbook file" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Classes="muted"
                       Text="{Binding FileStatus}"
                       IsVisible="{Binding FileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="flat">
          <Grid ColumnDefinitions="Auto,*">
            <controls:TwoToneIcon Data="{StaticResource ToneInfo}" SoftData="{StaticResource ToneInfoSoft}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Top" Width="16" Height="16" />
            <TextBlock Grid.Column="1"
                       Margin="10,0,0,0"
                       Classes="muted"
                       Text="Only accept a recipe when the person sending it is with you. Sedhep never sends anything on its own." />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- The QR panel: showing a code receives, scanning one sends. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            IsVisible="{Binding IsQrOpen}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="20" Padding="20" VerticalAlignment="Center">
        <StackPanel Spacing="14">

          <!-- Show my code -->
          <StackPanel Spacing="12" IsVisible="{Binding IsShowCodeVisible}">
            <TextBlock Classes="h2" Text="Let the other phone scan this" />
            <TextBlock Classes="muted"
                       Text="On the other phone open Share and tap “Scan a code”. Hold the picture steady in front of it." />

            <Border Background="White" CornerRadius="18" Padding="14"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !IsCodeExpired}">
              <controls:QrCodeView Value="{Binding PairingCode}" Width="216" Height="216" />
            </Border>

            <TextBlock Classes="body"
                       HorizontalAlignment="Center"
                       Text="{Binding PairingCountdown}"
                       IsVisible="{Binding PairingCountdown, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Classes="muted"
                       HorizontalAlignment="Center"
                       Text="{Binding QrNote}"
                       IsVisible="{Binding IsCodeExpired}" />

            <TextBlock Classes="muted"
                       Text="{Binding QrStatus}"
                       IsVisible="{Binding QrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ProgressBar Minimum="0" Maximum="100" Value="{Binding QrProgress}" IsVisible="{Binding HasQrProgress}" />

            <Button Classes="primary"
                    Content="Done"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CloseQrCommand}" />

            <Button Classes="outline"
                    Content="Show a new code"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding IsCodeExpired}"
                    Command="{Binding NewQrCodeCommand}" />

            <Button Classes="bare"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding !IsCodeExpired}"
                    Command="{Binding CopyQrCodeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:TwoToneIcon Data="{StaticResource ToneContentCopy}"
                                      SoftData="{StaticResource ToneContentCopySoft}"
                                      Foreground="{DynamicResource TextTertiary}"
                                      Width="14" Height="14" />
                <TextBlock Classes="meta" Text="Copy the code instead" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Scan someone else's code -->
          <StackPanel Spacing="12" IsVisible="{Binding IsScanVisible}">
            <TextBlock Classes="h2" Text="Scan the other phone's code" />
            <TextBlock Classes="muted"
                       Text="Take a picture of the code on the other screen, then open it here. Copying the code on the other phone and pasting it also works." />

            <Button Classes="primary"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ChooseQrPictureCommand}"
                    AutomationProperties.Name="Open a picture of the code">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:TwoToneIcon Data="{StaticResource TonePhotoCamera}"
                                      SoftData="{StaticResource TonePhotoCameraSoft}"
                                      Width="16" Height="16" />
                <TextBlock Text="Open a picture of the code" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="outline"
                    Content="Paste a copied code"
                    HorizontalAlignment="Stretch"
                    Command="{Binding PasteQrCodeCommand}" />

            <TextBox Watermark="or paste the code here" Text="{Binding ScannedCode}" />

            <Button Classes="outline"
                    Content="Use this code"
                    HorizontalAlignment="Stretch"
                    IsVisible="{Binding HasTypedCode}"
                    Command="{Binding UseTypedCodeCommand}" />

            <TextBlock Classes="muted"
                       Text="{Binding QrStatus}"
                       IsVisible="{Binding QrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Classes="bare" Content="Cancel" HorizontalAlignment="Center" Command="{Binding CloseQrCommand}" />
          </StackPanel>

          <!-- The code was read: send what this page is set to send -->
          <StackPanel Spacing="12" IsVisible="{Binding IsScannedVisible}">
            <TextBlock Classes="h2" Text="{Binding ScannedDeviceLabel}" />
            <TextBlock Classes="muted" Text="Found a phone that is ready to receive." />
            <TextBlock Classes="body" Text="{Binding ScopeHint}" />

            <ProgressBar Minimum="0" Maximum="100" Value="{Binding QrProgress}" IsVisible="{Binding HasQrProgress}" />

            <TextBlock Classes="muted"
                       Text="{Binding QrStatus}"
                       IsVisible="{Binding QrStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Classes="primary"
                    Content="Send the recipes"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding !IsQrBusy}"
                    Command="{Binding SendToScannedCommand}" />

            <Button Classes="outline"
                    Content="Back"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ScanQrCodeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The same recipe on both sides: the user picks which copy the cookbook keeps. -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            IsVisible="{Binding HasPendingConflict}"
            Background="{DynamicResource Scrim}">
      <Border Classes="card" Margin="24" Padding="20" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <Border Classes="pill accent" HorizontalAlignment="Left">
            <TextBlock Classes="label" Text="SAME RECIPE, TWO VERSIONS" Foreground="{DynamicResource AccentInk}" />
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="{Binding PendingConflict.Title}" />
            <TextBlock Classes="muted" Text="{Binding ConflictDetails}" />
          </StackPanel>

          <TextBlock Classes="muted" Text="Choose which one stays in your cookbook. Neither is thrown away until you decide." />

          <StackPanel Spacing="8">
            <Button Classes="primary"
                    Content="Keep my version"
                    HorizontalAlignment="Stretch"
                    Command="{Binding KeepMineCommand}" />
            <Button Classes="outline"
                    Content="Use the incoming version"
                    HorizontalAlignment="Stretch"
                    Command="{Binding UseIncomingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
