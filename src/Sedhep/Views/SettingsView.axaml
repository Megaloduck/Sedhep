<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Sedhep.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="800"
             x:Class="Sedhep.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer Background="{DynamicResource Page}">
    <StackPanel Margin="18,16,18,24" Spacing="14">
      <StackPanel Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon sm accent" Data="{StaticResource IconSliders}" VerticalAlignment="Center" />
          <TextBlock Classes="eyebrow" Text="YOUR COOKBOOK" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="title" Text="Settings" />
        <TextBlock Classes="muted" Text="A few choices, nothing to sign up for." />
      </StackPanel>

      <!-- How it looks -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="label" Text="APPEARANCE" />

          <StackPanel Spacing="8">
            <TextBlock Classes="meta" Text="Theme" />
            <Border Classes="flat" Padding="4">
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="chip" Margin="0,0,2,0" Classes.active="{Binding IsSystemTheme}" Content="System" Command="{Binding UseSystemThemeCommand}" />
                <Button Grid.Column="1" Classes="chip" Margin="2,0" Classes.active="{Binding IsLightTheme}" Content="Light" Command="{Binding UseLightThemeCommand}" />
                <Button Grid.Column="2" Classes="chip" Margin="2,0,0,0" Classes.active="{Binding IsDarkTheme}" Content="Dark" Command="{Binding UseDarkThemeCommand}" />
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="meta" Text="Text size" />
            <Border Classes="flat" Padding="4">
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="chip" Margin="0,0,2,0" Classes.active="{Binding IsTextNormal}" Content="Standard" Command="{Binding UseSmallTextCommand}" />
                <Button Grid.Column="1" Classes="chip" Margin="2,0" Classes.active="{Binding IsTextLarge}" Content="Large" Command="{Binding UseLargeTextCommand}" />
                <Button Grid.Column="2" Classes="chip" Margin="2,0,0,0" Classes.active="{Binding IsTextLargest}" Content="Largest" Command="{Binding UseLargestTextCommand}" />
              </Grid>
            </Border>
            <TextBlock Classes="muted" Text="Everything in the app grows, including cooking mode." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Where the cookbook lives. A desktop folder the user can open, copy and change. -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="label" Text="COOKBOOK LOCATION" />

          <Border Classes="flat">
            <StackPanel Spacing="4">
              <TextBlock Classes="meta" Text="{Binding LocationSourceText}" />
              <SelectableTextBlock Classes="body" Text="{Binding StorageFolder}" TextWrapping="Wrap" />
              <TextBlock Classes="meta"
                         Text="{Binding DatabaseFileName, StringFormat='{}{0} and the photos folder live here.'}" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*" IsVisible="{Binding CanChangeLocation}">
            <Button Grid.Column="0"
                    Classes="outline"
                    Content="Open folder"
                    Command="{Binding OpenFolderCommand}"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch" />
            <Button Grid.Column="1"
                    Classes="outline"
                    Content="Change folder…"
                    Command="{Binding ChangeLocationCommand}"
                    Margin="4,0,0,0"
                    HorizontalAlignment="Stretch" />
          </Grid>

          <TextBlock Classes="muted"
                     IsVisible="{Binding CanChangeLocation}"
                     Text="Changing the folder restarts Sedhep. Your recipes are only moved when you ask for a copy." />
        </StackPanel>
      </Border>

      <!-- The cookbook itself -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="label" Text="COOKBOOK" />

          <Button Classes="bare" Command="{Binding OpenCategoriesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Border Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource SurfaceMuted}" VerticalAlignment="Center">
                <Path Classes="icon sm" Data="{StaticResource IconFolder}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="Categories" />
                <TextBlock Classes="meta" Text="{Binding CategoryCountLabel}" />
              </StackPanel>
              <Path Grid.Column="3" Classes="icon sm" Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
            </Grid>
            </Border>
          </Button>

          <Border Classes="divider" />

          <StackPanel Spacing="6">
            <TextBlock Classes="meta" Text="This device's name" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Text="{Binding DeviceName, Mode=TwoWay}"
                       Watermark="e.g. Rina's phone"
                       Margin="0,0,8,0" />
              <Button Grid.Column="1" Classes="outline" Content="Save" Command="{Binding SaveDeviceNameCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="Other phones see this name when you share a recipe." />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Sharing and backups -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="label" Text="SHARING AND BACKUP" />

          <Button Classes="bare" Command="{Binding OpenShareCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Border Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="36" Height="36" CornerRadius="12" Background="{DynamicResource SurfaceMuted}" VerticalAlignment="Center">
                <Path Classes="icon sm" Data="{StaticResource IconShare}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="h3" Text="Send to a nearby phone" />
                <TextBlock Classes="meta" Text="Or save the cookbook as a file" />
              </StackPanel>
              <Path Grid.Column="2" Classes="icon sm" Data="{StaticResource IconChevronRight}" VerticalAlignment="Center" />
            </Grid>
            </Border>
          </Button>

          <TextBlock Classes="muted"
                     Text="Transfers happen directly between devices on your own Wi-Fi. Nothing is uploaded anywhere." />
        </StackPanel>
      </Border>

      <!-- About -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="ABOUT" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="40" Height="40" CornerRadius="14" Background="{DynamicResource AccentSoft}">
              <Path Classes="icon" Data="{StaticResource IconPot}" Stroke="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="Sedhep" />
              <TextBlock Classes="meta" Text="{Binding VersionText, StringFormat='Version {0}'}" />
            </StackPanel>
          </StackPanel>

          <TextBlock Classes="muted"
                     Text="A private family cookbook. Your recipes stay on this device unless you choose to send them." />

          <TextBlock Classes="muted"
                     Text="{Binding RecipeCountLabel, StringFormat='{}{0} in this cookbook'}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="muted"
                 TextAlignment="Center"
                 Margin="0,4,0,0"
                 Text="No accounts · No ads · No subscription" />

      <TextBlock Classes="muted"
                 Text="{Binding Status}"
                 TextAlignment="Center"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
